# Django
SECRET_KEY=replace-this-with-a-secure-secret
# DEBUG must be False in production. Defaults to True for local development.
DEBUG=True
# Comma-separated list of allowed hosts (required when DEBUG=False).
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# DATABASE_ENGINE=sqlite (default) or postgres. The DATABASE_* values below
# are only used when DATABASE_ENGINE=postgres.
DATABASE_ENGINE=sqlite
DATABASE_NAME=zenspend_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Bank aggregation provider config
BANK_PROVIDER=mock
BANK_PROVIDER_BASE_URL=
BANK_PROVIDER_CLIENT_ID=
BANK_PROVIDER_CLIENT_SECRET=

# SSO configuration
SSO_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/sso/callback
SSO_STATE_MAX_AGE_SECONDS=600

SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=

SSO_FACEBOOK_CLIENT_ID=
SSO_FACEBOOK_CLIENT_SECRET=

SSO_MICROSOFT_TENANT=common
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=

# Password reset flow
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=3600
PASSWORD_RESET_EXPOSE_LINK=true
PASSWORD_RESET_EMAIL_SUBJECT=ZenSpend - Reinitialisation de mot de passe
PASSWORD_RESET_EMAIL_PROVIDER=resend
PASSWORD_RESET_EMAIL_ALLOW_FALLBACK=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@zenspend.local

# Resend email service
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@zenspend.local
RESEND_REPLY_TO=
